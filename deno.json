{
  "tasks": {
    "dev": "deno run -A --env=.env --watch main.ts",
    "db:push": "deno task --cwd=packages/db db:push",
    "db:push:prod": "deno task --cwd=packages/db db:push:prod",
    "db:generate": "deno task --cwd=packages/db db:generate"
  },
  "imports": {
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.10.0",
    "@std/assert": "jsr:@std/assert@1",
    "prisma": "npm:prisma@8.0.0-rc.19",
    "zod": "npm:zod@^4.6.5",

    "@packages/db": "./packages/db/index.ts",
    "@packages/websockets": "./packages/websockets/index.ts",
    "@packages/mmr": "./packages/mmr/index.ts",
    "@packages/auth": "./packages/auth/index.ts"
  },
  "nodeModulesDir": "auto",
  "allowScripts": {
    "allow": [],
    "deny": ["npm:esbuild@0.28.2", "npm:workerd@1.20260901.1"]
  }
}
